---
import type { GadgetProduct } from "@/data/gadgets";

interface Props {
  product: GadgetProduct;
}

const { product } = Astro.props;
const firstImage = product.images[0];
const galleryId = "gadget-gallery-" + product.slug;
---

<article
  class="gadget-card flex h-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white transition-shadow hover:shadow-md"
  data-category={product.category}
  data-search={
    product.name + " " + product.category + " " + product.description
  }
>
  <div class="p-4 pb-0 sm:p-5 sm:pb-0" data-gadget-gallery>
    <div class="relative aspect-square overflow-hidden rounded-xl bg-gradient-to-br from-brand-50 via-white to-accent-100">
      {firstImage ? (
        <button
          class="group relative flex size-full cursor-zoom-in items-center justify-center focus-visible:outline-2 focus-visible:outline-offset-[-3px] focus-visible:outline-brand-700"
          type="button"
          data-gallery-open
          aria-label={"Enlarge " + product.name + " image"}
        >
          <img
            class="size-full object-contain p-3 transition-opacity duration-200 motion-reduce:transition-none"
            src={firstImage.src}
            alt={firstImage.alt}
            loading="lazy"
            decoding="async"
            width="600"
            height="600"
            data-gallery-main
            data-gallery-image
          />
          <span
            class="absolute inset-0 hidden items-center justify-center bg-white/80 p-4 text-center text-sm font-medium text-slate-700"
            data-gallery-image-fallback
          >
            Image unavailable
          </span>
          <span class="absolute bottom-3 right-3 rounded-full bg-white/95 px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-sm transition-colors group-hover:text-brand-800">
            View image
          </span>
        </button>
      ) : (
        <div class="flex size-full flex-col items-center justify-center gap-3 p-6 text-center">
          <svg
            class="size-14 text-brand-700"
            viewBox="0 0 48 48"
            fill="none"
            aria-hidden="true"
          >
            <rect
              x="8"
              y="12"
              width="32"
              height="27"
              rx="5"
              stroke="currentColor"
              stroke-width="2"
            />
            <path
              d="M17 12V9.5A2.5 2.5 0 0 1 19.5 7h9A2.5 2.5 0 0 1 31 9.5V12M18 22h12M18 28h8"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            />
          </svg>
          <p class="text-xs font-medium text-slate-600">
            Product image not supplied
          </p>
        </div>
      )}
    </div>

    {product.images.length > 0 && (
      <div
        class="mt-3 flex gap-2 overflow-x-auto pb-1"
        role="group"
        aria-label={"Choose an image of " + product.name}
      >
        {product.images.map((image, index) => (
          <button
            class:list={[
              "relative size-16 shrink-0 overflow-hidden rounded-lg border bg-white p-1 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-700 sm:size-[4.5rem]",
              index === 0
                ? "border-brand-700 ring-2 ring-brand-700 ring-offset-1"
                : "border-slate-200 hover:border-brand-500",
            ]}
            type="button"
            data-gallery-thumb
            data-image-index={index}
            data-image-src={image.src}
            data-image-alt={image.alt}
            aria-label={
              "Show image " +
              (index + 1) +
              " of " +
              product.images.length +
              " for " +
              product.name
            }
            aria-pressed={index === 0 ? "true" : "false"}
          >
            <img
              class="size-full rounded-md object-contain"
              src={image.src}
              alt=""
              loading="lazy"
              decoding="async"
              width="100"
              height="100"
              data-gallery-image
            />
            <span
              class="absolute inset-0 hidden items-center justify-center bg-white/90 px-1 text-center text-[10px] text-slate-600"
              data-gallery-image-fallback
              aria-hidden="true"
            >
              Unavailable
            </span>
          </button>
        ))}
      </div>
    )}

    {firstImage && (
      <dialog
        class="m-auto max-h-[96dvh] w-[calc(100vw-1rem)] max-w-6xl overflow-auto rounded-2xl border-0 bg-white p-0 text-slate-950 shadow-2xl backdrop:bg-slate-950/80"
        data-gallery-dialog
        aria-labelledby={galleryId + "-title"}
        aria-describedby={galleryId + "-keyboard-help"}
      >
        <div class="p-3 sm:p-5">
          <header class="mb-3 flex items-center justify-between gap-3">
            <h2
              class="text-sm font-semibold text-slate-900 sm:text-base"
              id={galleryId + "-title"}
            >
              {product.name} image viewer
            </h2>
            <div class="flex shrink-0 items-center gap-3">
              <p
                class="text-xs tabular-nums text-slate-600"
                data-gallery-count
                aria-live="polite"
              >
                1 of {product.images.length}
              </p>
              <button
                class="inline-flex size-10 items-center justify-center rounded-full border border-slate-300 text-xl leading-none text-slate-700 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-700"
                type="button"
                data-gallery-close
                aria-label="Close image viewer"
              >
                <span aria-hidden="true">&times;</span>
              </button>
            </div>
          </header>
          <div class="flex items-center gap-2 sm:gap-4">
            <button
              class="inline-flex size-10 shrink-0 items-center justify-center rounded-full border border-slate-300 text-2xl leading-none text-slate-700 hover:bg-slate-100 disabled:cursor-not-allowed disabled:opacity-40 sm:size-12"
              type="button"
              data-gallery-previous
              aria-label="Previous image"
              disabled={product.images.length <= 1}
            >
              <span aria-hidden="true">&lsaquo;</span>
            </button>
            <div class="relative flex min-h-56 min-w-0 flex-1 items-center justify-center overflow-hidden rounded-xl bg-slate-50">
              <img
                class="max-h-[72dvh] w-full object-contain transition-opacity duration-200 motion-reduce:transition-none"
                src={firstImage.src}
                alt={firstImage.alt}
                decoding="async"
                width="1000"
                height="1000"
                data-gallery-viewer-image
                data-gallery-image
              />
              <span
                class="absolute inset-0 hidden items-center justify-center p-4 text-center text-sm text-slate-600"
                data-gallery-image-fallback
              >
                This image is unavailable.
              </span>
            </div>
            <button
              class="inline-flex size-10 shrink-0 items-center justify-center rounded-full border border-slate-300 text-2xl leading-none text-slate-700 hover:bg-slate-100 disabled:cursor-not-allowed disabled:opacity-40 sm:size-12"
              type="button"
              data-gallery-next
              aria-label="Next image"
              disabled={product.images.length <= 1}
            >
              <span aria-hidden="true">&rsaquo;</span>
            </button>
          </div>
          <p
            class="sr-only"
            id={galleryId + "-keyboard-help"}
            data-gallery-keyboard-help
          >
            Use the left and right arrow keys to change images. Press Escape to
            close.
          </p>
        </div>
      </dialog>
    )}
  </div>

  <p class="px-5 pt-3 text-xs text-slate-500">
    Illustrative stock image; not the exact Temu product.
  </p>

  <div class="flex flex-1 flex-col p-5">
    <p class="text-xs font-semibold uppercase tracking-wide text-brand-700">
      {product.category}
    </p>
    <h2 class="mt-2 text-lg font-semibold tracking-tight text-slate-950">
      {product.name}
    </h2>
    <p class="mt-2 flex-1 text-sm leading-6 text-slate-600">
      {product.description}
    </p>
    <a
      class="mt-5 inline-flex min-h-11 items-center justify-center gap-2 rounded-lg bg-brand-800 px-4 text-sm font-semibold text-white transition-colors hover:bg-brand-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-700"
      href={product.affiliateUrl}
      target="_blank"
      rel="sponsored nofollow noopener noreferrer"
      aria-label={"Buy " + product.name + " on Temu (opens in a new tab)"}
    >
      Buy on Temu
      <svg class="size-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path
          d="M11 3h6v6M17 3l-8 8M15 11v5a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </a>
  </div>
</article>

<script>
  import {
    getAdjacentImageIndex,
    normalizeImageIndex,
  } from "@/lib/gadgets/gallery";

  document
    .querySelectorAll<HTMLElement>("[data-gadget-gallery]")
    .forEach((gallery) => {
      const thumbnails = Array.from(
        gallery.querySelectorAll<HTMLButtonElement>("[data-gallery-thumb]"),
      );
      const mainImage = gallery.querySelector<HTMLImageElement>(
        "[data-gallery-main]",
      );
      const viewerImage = gallery.querySelector<HTMLImageElement>(
        "[data-gallery-viewer-image]",
      );
      const dialog = gallery.querySelector<HTMLDialogElement>(
        "[data-gallery-dialog]",
      );
      const openButton = gallery.querySelector<HTMLButtonElement>(
        "[data-gallery-open]",
      );
      const closeButton = gallery.querySelector<HTMLButtonElement>(
        "[data-gallery-close]",
      );
      const previousButton = gallery.querySelector<HTMLButtonElement>(
        "[data-gallery-previous]",
      );
      const nextButton = gallery.querySelector<HTMLButtonElement>(
        "[data-gallery-next]",
      );
      const count = gallery.querySelector<HTMLElement>("[data-gallery-count]");

      if (!mainImage || thumbnails.length === 0) return;
      const activeMainImage = mainImage;

      let selectedIndex = 0;

      function updateImage(image: HTMLImageElement, src: string, alt: string) {
        const fallback = image.parentElement?.querySelector<HTMLElement>(
          "[data-gallery-image-fallback]",
        );
        fallback?.classList.add("hidden");
        image.hidden = false;
        image.classList.add("opacity-60");
        image.src = src;
        image.alt = alt;
        requestAnimationFrame(() => image.classList.remove("opacity-60"));
      }

      function selectImage(index: number) {
        selectedIndex = normalizeImageIndex(index, thumbnails.length);
        const selected = thumbnails[selectedIndex];
        if (!selected) return;

        const src = selected.dataset.imageSrc;
        const alt = selected.dataset.imageAlt ?? "";
        if (!src) return;

        updateImage(activeMainImage, src, alt);
        if (viewerImage) updateImage(viewerImage, src, alt);

        thumbnails.forEach((thumbnail, thumbnailIndex) => {
          const isSelected = thumbnailIndex === selectedIndex;
          thumbnail.setAttribute("aria-pressed", String(isSelected));
          thumbnail.classList.toggle("border-brand-700", isSelected);
          thumbnail.classList.toggle("ring-2", isSelected);
          thumbnail.classList.toggle("ring-brand-700", isSelected);
          thumbnail.classList.toggle("ring-offset-1", isSelected);
          thumbnail.classList.toggle("border-slate-200", !isSelected);
        });

        if (count)
          count.textContent = selectedIndex + 1 + " of " + thumbnails.length;
      }

      function moveImage(direction: -1 | 1) {
        selectImage(
          getAdjacentImageIndex(selectedIndex, direction, thumbnails.length),
        );
      }

      gallery
        .querySelectorAll<HTMLImageElement>("[data-gallery-image]")
        .forEach((image) => {
          const showFallback = () => {
            image.hidden = true;
            image.parentElement
              ?.querySelector<HTMLElement>("[data-gallery-image-fallback]")
              ?.classList.remove("hidden");
          };
          image.addEventListener("error", showFallback);
          if (image.complete && image.naturalWidth === 0) showFallback();
        });

      thumbnails.forEach((thumbnail, index) => {
        thumbnail.addEventListener("click", () => selectImage(index));
      });

      openButton?.addEventListener("click", () => {
        if (dialog?.showModal) {
          selectImage(selectedIndex);
          dialog.showModal();
          closeButton?.focus();
        }
      });

      closeButton?.addEventListener("click", () => dialog?.close());
      previousButton?.addEventListener("click", () => moveImage(-1));
      nextButton?.addEventListener("click", () => moveImage(1));

      dialog?.addEventListener("keydown", (event) => {
        if (event.key === "ArrowLeft") {
          event.preventDefault();
          moveImage(-1);
        } else if (event.key === "ArrowRight") {
          event.preventDefault();
          moveImage(1);
        }
      });
    });
</script>
