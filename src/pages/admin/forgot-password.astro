---
import BaseLayout from "@/layouts/BaseLayout.astro";

export const prerender = false;
Astro.response.headers.set("Cache-Control", "private, no-store");
---

<BaseLayout title="Reset staff password | Dee-Faith Pride Multi-Biz">
  <main id="main-content" class="mx-auto max-w-lg px-5 py-16 sm:px-8">
    <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-brand-700">
        Staff access
      </p>
      <h1 class="mt-2 text-3xl font-semibold tracking-tight text-brand-900">
        Forgot your password?
      </h1>
      <p class="mt-3 text-sm leading-6 text-slate-600">
        Enter the email address for your staff account. If an account matches,
        we will send instructions to reset its password.
      </p>
      <form class="mt-7 space-y-5" data-forgot-password>
        <div>
          <label
            class="mb-1.5 block text-sm font-medium text-slate-800"
            for="recovery-email"
          >
            Email
          </label>
          <input
            class="min-h-11 w-full rounded-lg border border-slate-300 px-3 text-sm"
            id="recovery-email"
            name="email"
            type="email"
            autocomplete="email"
            maxlength="254"
            required
          />
        </div>
        <button
          class="inline-flex min-h-11 items-center justify-center rounded-lg bg-brand-800 px-5 text-sm font-semibold text-white hover:bg-brand-900 disabled:cursor-wait disabled:opacity-60"
          type="submit"
        >
          Send recovery email
        </button>
        <p
          class="text-sm text-slate-700"
          data-recovery-status
          role="status"
          aria-live="polite"
        ></p>
      </form>
      <a
        class="mt-6 inline-flex text-sm font-semibold text-brand-800 underline underline-offset-4 hover:text-brand-700"
        href="/admin/login"
      >
        Back to admin sign in
      </a>
    </section>
  </main>
</BaseLayout>

<script>
  interface RecoveryResponse {
    error?: string;
    message?: string;
  }

  const form = document.querySelector<HTMLFormElement>(
    "[data-forgot-password]",
  );
  const status = document.querySelector<HTMLElement>("[data-recovery-status]");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!status) return;
    const button = form.querySelector<HTMLButtonElement>(
      'button[type="submit"]',
    );
    if (!button) return;
    button.disabled = true;
    status.textContent = "Sending request…";

    try {
      const response = await fetch("/api/admin/forgot-password", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email: new FormData(form).get("email") }),
      });
      const result = (await response.json()) as RecoveryResponse;
      status.textContent = response.ok
        ? (result.message ??
          "If an account matches, recovery instructions will be sent.")
        : (result.error ??
          "The request could not be processed. Please try again.");
    } catch {
      status.textContent =
        "Unable to reach the recovery service. Please try again.";
    } finally {
      button.disabled = false;
    }
  });
</script>
