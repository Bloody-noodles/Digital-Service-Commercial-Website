---
import BaseLayout from "@/layouts/BaseLayout.astro";

export const prerender = false;
Astro.response.headers.set("Cache-Control", "private, no-store");
Astro.response.headers.set("Referrer-Policy", "no-referrer");

const callbackUrl = new URL(Astro.request.url);
const code = callbackUrl.searchParams.get("code");
const flowId = callbackUrl.searchParams.get("sb_flow_id");

if (code) {
  const fragment = new URLSearchParams({ recovery_code: code });
  if (flowId) fragment.set("sb_flow_id", flowId);
  return Astro.redirect("/admin/reset-password#" + fragment.toString(), 303);
}

let statusMessage =
  "Open the recovery link from your email, or request a new one.";
let statusKind: "error" | "info" = "info";
if (
  callbackUrl.searchParams.has("error") ||
  callbackUrl.searchParams.get("status") === "invalid"
) {
  statusMessage =
    "This recovery link is invalid, expired, or already used. Request a new link.";
  statusKind = "error";
}
---

<BaseLayout title="Choose a new password | Dee-Faith Pride Multi-Biz">
  <main id="main-content" class="mx-auto max-w-lg px-5 py-16 sm:px-8">
    <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-brand-700">
        Staff access
      </p>
      <h1 class="mt-2 text-3xl font-semibold tracking-tight text-brand-900">
        Choose a new password
      </h1>
      <p
        class:list={[
          "mt-4 rounded-lg p-4 text-sm leading-6",
          statusKind === "error"
            ? "bg-rose-50 text-rose-900"
            : "bg-amber-50 text-amber-950",
        ]}
        data-reset-notice
        role={statusKind === "error" ? "alert" : "status"}
      >
        {statusMessage}
      </p>
      <form class="mt-7 hidden space-y-5" data-reset-password hidden>
        <div>
          <label
            class="mb-1.5 block text-sm font-medium text-slate-800"
            for="new-password"
          >
            New password
          </label>
          <input
            class="min-h-11 w-full rounded-lg border border-slate-300 px-3 text-sm"
            id="new-password"
            name="newPassword"
            type="password"
            autocomplete="new-password"
            minlength="12"
            maxlength="256"
            required
          />
        </div>
        <div>
          <label
            class="mb-1.5 block text-sm font-medium text-slate-800"
            for="confirm-password"
          >
            Confirm new password
          </label>
          <input
            class="min-h-11 w-full rounded-lg border border-slate-300 px-3 text-sm"
            id="confirm-password"
            name="confirmPassword"
            type="password"
            autocomplete="new-password"
            minlength="12"
            maxlength="256"
            required
          />
        </div>
        <button
          class="inline-flex min-h-11 items-center justify-center rounded-lg bg-brand-800 px-5 text-sm font-semibold text-white hover:bg-brand-900 disabled:cursor-wait disabled:opacity-60"
          type="submit"
        >
          Update password
        </button>
        <p
          class="text-sm text-slate-700"
          data-reset-status
          role="status"
          aria-live="polite"
        ></p>
      </form>
      <a
        class="mt-6 inline-flex text-sm font-semibold text-brand-800 underline underline-offset-4 hover:text-brand-700"
        href="/admin/forgot-password"
      >
        Request a new recovery email
      </a>
      <a
        class="mt-6 inline-flex text-sm font-semibold text-brand-800 underline underline-offset-4 hover:text-brand-700"
        href="/admin/login"
      >
        Back to admin sign in
      </a>
    </section>
  </main>
</BaseLayout>

<script>
  interface ResetResponse {
    error?: string;
    message?: string;
    redirect?: string;
    remoteRevocationFailed?: boolean;
  }

  const form = document.querySelector<HTMLFormElement>("[data-reset-password]");
  const notice = document.querySelector<HTMLElement>("[data-reset-notice]");
  const status = document.querySelector<HTMLElement>("[data-reset-status]");
  const callback = new URLSearchParams(window.location.hash.slice(1));
  let recoveryCode = callback.get("recovery_code");
  let flowId = callback.get("sb_flow_id");

  function clearAddressFragment() {
    window.history.replaceState(null, "", window.location.pathname);
  }

  function clearRecoveryCode() {
    recoveryCode = null;
    flowId = null;
    callback.delete("recovery_code");
    callback.delete("sb_flow_id");
    clearAddressFragment();
  }

  if (recoveryCode && form) {
    form.hidden = false;
    form.classList.remove("hidden");
    if (notice) notice.textContent = "Choose a new password to continue.";
    clearAddressFragment();
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!status || !recoveryCode) return;
    const button = form.querySelector<HTMLButtonElement>(
      'button[type="submit"]',
    );
    if (!button) return;

    const formData = new FormData(form);
    const newPassword = String(formData.get("newPassword") ?? "");
    const confirmPassword = String(formData.get("confirmPassword") ?? "");
    if (newPassword !== confirmPassword) {
      status.textContent = "The passwords do not match.";
      return;
    }

    button.disabled = true;
    status.textContent = "Updating password…";
    try {
      const response = await fetch("/api/admin/reset-password", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          code: recoveryCode,
          flowId,
          newPassword,
          confirmPassword,
        }),
      });
      const result = (await response.json()) as ResetResponse;
      clearRecoveryCode();
      form.hidden = true;
      form.classList.add("hidden");
      form.reset();
      if (!response.ok) {
        if (notice) {
          notice.textContent = result.error ?? "Password could not be updated.";
          notice.setAttribute("role", "alert");
        }
        return;
      }
      if (notice) {
        notice.textContent =
          result.message ?? "Password updated. Redirecting to sign in.";
        notice.setAttribute("role", "status");
      }
      window.setTimeout(
        () => window.location.assign(result.redirect ?? "/admin/login"),
        result.remoteRevocationFailed ? 2500 : 800,
      );
    } catch {
      clearRecoveryCode();
      form.hidden = true;
      form.classList.add("hidden");
      form.reset();
      if (notice) {
        notice.textContent =
          "The recovery request could not be completed. Request a new recovery email and try again.";
        notice.setAttribute("role", "alert");
      }
    } finally {
      button.disabled = false;
    }
  });
</script>
