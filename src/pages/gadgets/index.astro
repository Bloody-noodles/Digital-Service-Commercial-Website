---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageIntro from "@/components/ui/PageIntro.astro";
import GadgetCard from "@/components/gadgets/GadgetCard.astro";
import { gadgetCategories, gadgetProducts } from "@/data/gadgets";
---

<BaseLayout
  title="Gadgets & Electronics | Dee-Faith Pride Multi-Biz"
  description="Browse gadgets and electronics selected by Dee-Faith Pride. Purchases are completed on Temu."
>
  <main id="main-content">
    <PageIntro
      eyebrow="Gadgets & Electronics"
      title="Find your next gadget"
      description="Browse our gadget picks and follow a product link to view it on Temu."
    />

    <section class="mx-auto max-w-7xl px-5 py-10 sm:px-8">
      <aside
        class="rounded-2xl border border-brand-100 bg-brand-50 p-5 sm:p-6"
        aria-label="Affiliate disclosure and purchase information"
      >
        <p class="text-sm font-semibold leading-6 text-brand-900">
          Dee-Faith Pride may earn a commission when you purchase products
          through our Temu affiliate links. This comes at no additional cost to
          you. All purchases, payments and deliveries are handled directly by
          Temu.
        </p>
        <p class="mt-2 text-sm leading-6 text-slate-700">
          Check Temu for current prices and product details; they may change.
        </p>
      </aside>

      <div class="mt-8 grid gap-4 sm:grid-cols-[1fr_16rem]">
        <div>
          <label
            class="mb-2 block text-sm font-semibold text-slate-800"
            for="gadget-search"
          >
            Search gadgets
          </label>
          <input
            class="min-h-12 w-full rounded-lg border border-slate-300 bg-white px-4 text-base outline-none focus:border-brand-700 focus:ring-2 focus:ring-brand-100"
            id="gadget-search"
            type="search"
            placeholder="Try power bank, cable, or speaker"
            autocomplete="off"
          />
        </div>
        <div>
          <label
            class="mb-2 block text-sm font-semibold text-slate-800"
            for="gadget-category"
          >
            Category
          </label>
          <select
            class="min-h-12 w-full rounded-lg border border-slate-300 bg-white px-4 text-base outline-none focus:border-brand-700 focus:ring-2 focus:ring-brand-100"
            id="gadget-category"
          >
            <option value="">All categories</option>
            {gadgetCategories.map((category) => (
              <option value={category}>{category}</option>
            ))}
          </select>
        </div>
      </div>

      <div
        class="mt-4 -mx-5 flex gap-2 overflow-x-auto px-5 pb-2 sm:mx-0 sm:flex-wrap sm:overflow-visible sm:px-0"
        role="group"
        aria-label="Quick gadget category filters"
      >
        {gadgetCategories.map((category) => (
          <button
            class="min-h-10 shrink-0 rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition-colors hover:border-brand-700 hover:text-brand-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-700"
            type="button"
            data-gadget-category={category}
          >
            {category}
          </button>
        ))}
      </div>

      <div class="mt-5 flex flex-wrap items-center justify-between gap-3">
        <p class="text-sm text-slate-600" id="gadget-count" aria-live="polite">
          {gadgetProducts.length} products shown
        </p>
        <button
          class="hidden min-h-10 rounded-lg border border-slate-300 px-4 text-sm font-semibold text-brand-800 hover:border-brand-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-700"
          id="clear-gadget-filters"
          type="button"
        >
          Clear filters
        </button>
      </div>

      <div
        class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3"
        id="gadget-list"
      >
        {gadgetProducts.map((product) => <GadgetCard product={product} />)}
      </div>

      <p
        class="hidden py-12 text-center text-slate-600"
        id="no-gadgets"
        role="status"
      >
        No gadgets match those filters. Try another search.
      </p>
    </section>
  </main>
</BaseLayout>

<script>
  const search = document.querySelector<HTMLInputElement>("#gadget-search");
  const category = document.querySelector<HTMLSelectElement>("#gadget-category");
  const cards = Array.from(
    document.querySelectorAll<HTMLElement>(".gadget-card"),
  );
  const count = document.querySelector<HTMLElement>("#gadget-count");
  const emptyState = document.querySelector<HTMLElement>("#no-gadgets");
  const clearButton = document.querySelector<HTMLButtonElement>(
    "#clear-gadget-filters",
  );
  const categoryButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-gadget-category]"),
  );

  function filterGadgets() {
    const query = search?.value.trim().toLocaleLowerCase() ?? "";
    const selectedCategory = category?.value ?? "";
    let visible = 0;

    for (const card of cards) {
      const matchesText =
        card.dataset.search?.toLocaleLowerCase().includes(query) ?? false;
      const matchesCategory =
        !selectedCategory || card.dataset.category === selectedCategory;
      const shouldShow = matchesText && matchesCategory;
      card.hidden = !shouldShow;
      if (shouldShow) visible += 1;
    }

    if (count) {
      count.textContent = `${visible} ${visible === 1 ? "product" : "products"} shown`;
    }
    emptyState?.classList.toggle("hidden", visible !== 0);
    clearButton?.classList.toggle("hidden", !query && !selectedCategory);

    for (const button of categoryButtons) {
      const isSelected = button.dataset.gadgetCategory === selectedCategory;
      button.setAttribute("aria-pressed", String(isSelected));
      button.classList.toggle("border-brand-700", isSelected);
      button.classList.toggle("bg-brand-50", isSelected);
      button.classList.toggle("text-brand-800", isSelected);
    }
  }

  search?.addEventListener("input", filterGadgets);
  category?.addEventListener("change", filterGadgets);

  categoryButtons.forEach((button) => {
    button.addEventListener("click", () => {
      if (category) category.value = button.dataset.gadgetCategory ?? "";
      filterGadgets();
    });
  });

  clearButton?.addEventListener("click", () => {
    if (search) search.value = "";
    if (category) category.value = "";
    filterGadgets();
    search?.focus();
  });

  filterGadgets();
</script>
