---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageIntro from "@/components/ui/PageIntro.astro";
import UpdateCard from "@/components/updates/UpdateCard.astro";
import { updateCategories, updates } from "@/data/updates";
---

<BaseLayout
  title="Deals, Opportunities & Updates | Dee-Faith Pride Multi-Biz"
  description="Find verified business promotions, gadget opportunities, education updates and important notices from Dee-Faith Pride Multi-Biz."
>
  <main id="main-content">
    <PageIntro
      eyebrow="What's happening"
      title="Deals, Opportunities & Updates"
      description="A central place for verified promotions, gadget opportunities, education updates and important business notices."
    />

    <section class="mx-auto max-w-7xl px-5 py-10 sm:px-8">
      <div class="rounded-2xl border border-brand-100 bg-brand-50 p-5 sm:p-6">
        <p class="max-w-4xl text-sm leading-6 text-brand-950">
          We publish offers and notices after their details are confirmed. Check
          each update's status and dates before acting. Gadget purchases are
          completed by Temu; prices and availability are shown on Temu.
        </p>
      </div>

      <div class="mt-8">
        <label
          class="mb-2 block text-sm font-semibold text-slate-800"
          for="update-search"
        >
          Search updates
        </label>
        <input
          class="min-h-12 w-full rounded-lg border border-slate-300 bg-white px-4 text-base outline-none focus:border-brand-700 focus:ring-2 focus:ring-brand-100 sm:max-w-xl"
          id="update-search"
          type="search"
          placeholder="Search promotions, exams, services or notices"
          autocomplete="off"
        />
      </div>

      <div
        class="mt-5 -mx-5 flex gap-2 overflow-x-auto px-5 pb-2 sm:mx-0 sm:flex-wrap sm:overflow-visible sm:px-0"
        role="group"
        aria-label="Filter updates by category"
      >
        {updateCategories.map((category) => (
          <button
            class:list={[
              "min-h-10 shrink-0 rounded-full border px-4 py-2 text-sm font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-700",
              category.id === "all"
                ? "border-brand-700 bg-brand-50 text-brand-800"
                : "border-slate-200 bg-white text-slate-700 hover:border-brand-700 hover:text-brand-800",
            ]}
            type="button"
            data-update-filter={category.id}
            aria-pressed={category.id === "all" ? "true" : "false"}
          >
            {category.label}
          </button>
        ))}
      </div>

      <div class="mt-5 flex flex-wrap items-center justify-between gap-3">
        <p class="text-sm text-slate-600" id="update-count" aria-live="polite">
          {updates.length} updates
        </p>
        <button
          class="hidden min-h-10 rounded-lg border border-slate-300 px-4 text-sm font-semibold text-brand-800 hover:border-brand-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-700"
          id="clear-update-filters"
          type="button"
        >
          Clear filters
        </button>
      </div>

      <div
        class="mt-4 grid gap-5 sm:grid-cols-2 lg:grid-cols-3"
        id="updates-list"
      >
        {updates.map((update) => (
          <UpdateCard update={update} />
        ))}
      </div>

      <div
        class:list={[
          "mt-4 rounded-2xl border border-dashed border-slate-300 bg-white px-6 py-12 text-center",
          updates.length > 0 && "hidden",
        ]}
        id="no-updates"
        role="status"
      >
        <h2 class="text-lg font-semibold text-slate-900" id="empty-title">
          No verified updates published yet
        </h2>
        <p
          class="mx-auto mt-2 max-w-2xl text-sm leading-6 text-slate-600"
          id="empty-description"
        >
          When confirmed promotions, education notices or business updates are
          approved, they will appear here with their dates and status.
        </p>
        <div class="mt-5 flex flex-wrap justify-center gap-3">
          <a
            class="inline-flex min-h-11 items-center justify-center rounded-lg bg-brand-800 px-4 text-sm font-semibold text-white hover:bg-brand-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-700"
            href="/gadgets"
          >
            Browse Gadgets & Electronics
          </a>
          <a
            class="inline-flex min-h-11 items-center justify-center rounded-lg border border-slate-300 px-4 text-sm font-semibold text-brand-800 hover:border-brand-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-700"
            href="/services"
          >
            Browse digital services
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  import { matchesUpdateFilters } from "@/lib/updates/centre";

  const search = document.querySelector<HTMLInputElement>("#update-search");
  const cards = Array.from(
    document.querySelectorAll<HTMLElement>("[data-update-card]"),
  );
  const filters = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-update-filter]"),
  );
  const count = document.querySelector<HTMLElement>("#update-count");
  const emptyState = document.querySelector<HTMLElement>("#no-updates");
  const emptyTitle = document.querySelector<HTMLElement>("#empty-title");
  const emptyDescription =
    document.querySelector<HTMLElement>("#empty-description");
  const clearButton = document.querySelector<HTMLButtonElement>(
    "#clear-update-filters",
  );
  let selectedCategory = "all";

  function filterUpdates() {
    const query = search?.value ?? "";
    let visible = 0;

    for (const card of cards) {
      const matches = matchesUpdateFilters(
        {
          category: card.dataset.category as
            | "deals-promotions"
            | "gadget-deals"
            | "education-updates"
            | "important-notices",
          title: "",
          description: (card.dataset.search ?? "").replace(
            card.dataset.category ?? "",
            "",
          ),
        },
        selectedCategory as
          | "all"
          | "deals-promotions"
          | "gadget-deals"
          | "education-updates"
          | "important-notices",
        query,
      );
      card.hidden = !matches;
      if (matches) visible += 1;
    }

    if (count) {
      count.textContent = visible + (visible === 1 ? " update" : " updates");
    }

    const hasFilters = Boolean(query.trim()) || selectedCategory !== "all";
    if (emptyState) emptyState.hidden = visible > 0;
    clearButton?.classList.toggle("hidden", !hasFilters);
    if (visible === 0 && hasFilters) {
      if (emptyTitle) emptyTitle.textContent = "No updates match these filters";
      if (emptyDescription) {
        emptyDescription.textContent =
          "Try another search or choose a different category.";
      }
    } else if (visible === 0) {
      if (emptyTitle) {
        emptyTitle.textContent = "No verified updates published yet";
      }
      if (emptyDescription) {
        emptyDescription.textContent =
          "When confirmed promotions, education notices or business updates are approved, they will appear here with their dates and status.";
      }
    }

    for (const filter of filters) {
      const selected = filter.dataset.updateFilter === selectedCategory;
      filter.setAttribute("aria-pressed", String(selected));
      filter.classList.toggle("border-brand-700", selected);
      filter.classList.toggle("bg-brand-50", selected);
      filter.classList.toggle("text-brand-800", selected);
      filter.classList.toggle("border-slate-200", !selected);
      filter.classList.toggle("bg-white", !selected);
      filter.classList.toggle("text-slate-700", !selected);
      filter.classList.toggle("hover:border-brand-700", !selected);
      filter.classList.toggle("hover:text-brand-800", !selected);
    }
  }

  search?.addEventListener("input", filterUpdates);

  filters.forEach((filter) => {
    filter.addEventListener("click", () => {
      selectedCategory = filter.dataset.updateFilter ?? "all";
      filterUpdates();
    });
  });

  clearButton?.addEventListener("click", () => {
    if (search) search.value = "";
    selectedCategory = "all";
    filterUpdates();
    search?.focus();
  });

  filterUpdates();
</script>
